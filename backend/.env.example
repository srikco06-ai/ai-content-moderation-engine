# ----------------------------------------------------
# Application
# ----------------------------------------------------

APP_NAME=AI Content Moderation API
APP_VERSION=1.0.0
DEBUG=False

API_PREFIX=

# ----------------------------------------------------
# CORS
# ----------------------------------------------------

ALLOW_CREDENTIALS=True
ALLOW_ORIGINS=*
ALLOW_METHODS=*
ALLOW_HEADERS=*

# ----------------------------------------------------
# Hugging Face ToxicBERT
# ----------------------------------------------------

HF_MODEL_NAME=unitary/toxic-bert
HF_DEVICE=cpu
HF_MAX_LENGTH=512
HF_BATCH_SIZE=8
HF_THRESHOLD=0.50